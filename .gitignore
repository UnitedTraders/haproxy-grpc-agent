# T025: Rust project .gitignore

# Rust build artifacts
/target
debug/
release/
*.rs.bk
*.rlib
*.prof*

# Cargo lock (keep for binaries, ignore for libraries)
# Cargo.lock

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
*.key
*.pem
*.crt
config.toml

# Logs
*.log

# Test artifacts
coverage/
*.profdata
*.profraw

# Docker
.dockerignore

# Temporary files
*.tmp
*.bak

# SpecKit specific
.specify/extensions
.specify/extensions.yml
.specify/feature.json
.specify/init-options.json
.specify/integration.json
.specify/integrations
.specify/scripts
.specify/templates
.specify/workflow.yml
.specify/workflows
.specify/.gitignore
.claude/skills/speckit*

# Coverage reports
lcov.info
